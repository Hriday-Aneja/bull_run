# Copy this file to .env and edit. Every value is optional: BullRun runs fully with none of them.

# Port for the web server
PORT=3000

# Where the SQLite database lives (relative to the project folder)
DB_PATH=data/bullrun.sqlite

# --- Optional AI: scenario text and the natural anchor voice ------------------------------
# Leave AI_API_KEY empty to use the built-in generator and the browser voices (nothing is lost; everything works offline).
# The key is read by the server only and is never sent to the browser.
#
# Using a GEMINI key (Google AI Studio):
#   AI_PROVIDER=gemini
#   AI_API_KEY=your-gemini-key
#   AI_MODEL=gemini-2.5-flash
# Using a CHATGPT / OpenAI key:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-your-openai-key
#   AI_MODEL=gpt-4o-mini
# (If a model name is rejected, the server log shows the provider's message. Set AI_MODEL to any chat model your key can use.)
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=
# Optional override, e.g. http://localhost:11434/v1 for a local OpenAI-compatible server
AI_BASE_URL=
# Give up on the AI after this many milliseconds and fall back to the built-in generator (default 20000 for Gemini, 18000 for OpenAI)
AI_TIMEOUT_MS=

# --- Natural anchor voice (BullRun Live) -------------------------------------------------------
# Automatic: if AI_PROVIDER is gemini or openai, the same key also gives the anchors natural voices.
# Set TTS_ENABLED=off to keep the free browser voices. The page falls back to them on any error.
# TTS_ENABLED=on
# Use a different key or provider for the voice only:
# TTS_PROVIDER=openai
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts        (Gemini default: gemini-3.1-flash-tts-preview)

# --- Emotional anchors (from the dualcast project) ---------------------------------------------
# AI-written anchor lines: with a Gemini or OpenAI key the anchors write each story the way a live anchor would say it, with an emotion on
# every line. Every line is fact-checked by the server before it can air (no invented numbers or names, rumours stay rumours); on any
# problem the built-in script is used. Set AI_SCRIPTS=off to turn this off. SCRIPT_TIMEOUT_MS is how long to wait for the model (default 7000).
# AI_SCRIPTS=on
# SCRIPT_TIMEOUT_MS=7000
#
# Optional voice engines from dualcast. Emotion tags like [excited] and [tense] work best with Fish Audio.
# TTS_PROVIDER=fish
# FISH_API_KEY=
# FISH_VOICE_FLASHWIRE=            (a Fish voice id per presenter: FLASHWIRE, MARKETLINE, UNDERCURRENT, SUNNY, TARA, ANNOUNCER)
# FISH_VOICE_DEFAULT=              (used for any presenter without its own)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_MARKETLINE=     (same naming; falls back to a default voice)

